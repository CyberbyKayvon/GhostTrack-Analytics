# Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
# For local development (SQLite):
# DATABASE_URL=sqlite:///./ghosttrack.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/ghosttrack
DATABASE_URL=sqlite:///./ghosttrack.db

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Security - CRITICAL: Generate a secure secret key!
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# NEVER use the default value in production!
SECRET_KEY=your-secret-key-change-me-generate-with-secrets-module

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated list)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=GhostTrack

# Optional: External Services
# IP Geolocation API (e.g., ipinfo.io, MaxMind)
# IPINFO_TOKEN=your-token-here
# MAXMIND_LICENSE_KEY=your-license-key-here

# Optional: Alert Notifications
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
